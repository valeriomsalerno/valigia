# =============================================================================
# .env.example — copia questo file in ".env" e personalizza i valori.
# Il file ".env" reale NON va condiviso ne' versionato (contiene segreti).
# =============================================================================

# Chiave segreta usata da Flask per firmare sessioni e token CSRF.
# IMPORTANTE: cambiala con una stringa lunga e casuale prima di andare
# online. Puoi generarne una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-questa-chiave-con-una-stringa-lunga-e-casuale

# Credenziali dell'utente amministratore creato al primissimo avvio
# (usate SOLO se il database e' vuoto). Dopo il primo login ti verra'
# comunque chiesto di impostare una nuova password dall'interfaccia.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Impostalo a "true" SOLO se il traffico arriva sempre e solo via HTTPS
# fino al container (con un Cloudflare Tunnel "classico" puoi lasciarlo
# a "false": e' Cloudflare a gestire il TLS verso l'esterno).
SESSION_COOKIE_SECURE=false
