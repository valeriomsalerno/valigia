cat > .gitignore << 'EOF'
# Ambienti virtuali e dipendenze
venv/
.venv/
__pycache__/
*.pyc

# Segreti e configurazione locale
.env

# Cartella dati persistente (database, catalogo personalizzato, tutto):
# esclusa per intero, non solo alcune estensioni al suo interno
data/

# Test e cache
.pytest_cache/
.coverage
htmlcov/

# Editor / OS
.DS_Store
.vscode/
.idea/
EOF
